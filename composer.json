  "provide": {
    "psr/log-implementation": "^1.0 || ^2.0 || ^3.0"
  },
  "require": {
    "php": "^8.2",
    "psr/clock": "^1.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "vaibhavpandeyvpz/samay": "^1.0"
  },
  "type": "library"
